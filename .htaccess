RewriteEngine On
RewriteBase /

# Une seule origine publique : eviter les doublons HTTP et www.
RewriteCond %{HTTP_HOST} ^(?:www\.)?atelierivoincidit\.fr$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.atelierivoincidit\.fr$ [NC]
RewriteRule ^ https://atelierivoincidit.fr%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/avif "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(?:avif|css|gif|jpe?g|js|png|svg|webp)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.woff2$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Bloquer l'acces web aux fichiers et dossiers internes de Laravel.
RewriteRule ^(?:app|bootstrap|config|database|docs|resources|routes|scripts|tests|vendor)(?:/|$) - [F,L,NC]
RewriteRule ^(?:\.env|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js)$ - [F,L,NC]

# LWS exposes the repository root rather than Laravel's public/ directory.
# Public uploads must therefore always go through the controlled Laravel route,
# even though the application itself has an internal storage/ directory.
RewriteRule ^storage/(.+)$ index.php/storage/$1 [L,QSA]

# Serve versioned public assets from their canonical Laravel location without
# duplicating them at the repository root. Do not depend on DOCUMENT_ROOT:
# LWS does not expose a stable value for it in every PHP/Apache setup.
RewriteRule ^((?:assets|build|css|demo|fonts|incidit-vox|js)(?:/.*)?)$ public/$1 [L]

# Routage Laravel deja utilise par LWS.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ index.php/$1 [L,QSA]
